{
  "manifest_version": 3,
  "name": "Tabs Now",
  "version": "1.0.0",
  "description": "Search Ultimate Guitar from a Firefox sidebar.",
  "developer": {
    "name": "Vivek Raman",
    "url": "https://vivekraman.dev"
  },
  "homepage_url": "https://vivekraman.dev",
  "permissions": ["tabs", "identity", "storage"],
  "host_permissions": [
    "https://accounts.spotify.com/*",
    "https://api.spotify.com/*"
  ],
  "optional_host_permissions": [
    "https://www.ultimate-guitar.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.ultimate-guitar.com/search.php*"],
      "js": ["src/content/open-most-rated.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "spotify-config.js",
      "src/background/spotify.js",
      "src/background/background.js"
    ]
  },
  "action": {
    "default_title": "Toggle Tabs Now sidebar"
  },
  "sidebar_action": {
    "default_title": "Tabs Now",
    "default_panel": "src/popup/popup.html",
    "open_at_install": false
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabs-now@vivekraman.dev",
      "strict_min_version": "109.0"
    }
  }
}
